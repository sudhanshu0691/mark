# Copy to config/runtime.env. Uncomment only settings you use.
# Keep real credentials and personal identifiers in the ignored local file.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MARK_WHATSAPP_TOKEN=
# SMTP_PASSWORD=
# SMTP_EMAIL=
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# MARK_WHATSAPP_RECIPIENT=
# MARK_WHATSAPP_PROVIDER=
# MARK_WHATSAPP_SENDER_ID=
# MARK_CAMERA_INDEX=0
# MARK_FACE_THRESHOLD=0.78
# MARK_UNKNOWN_DURATION=10
# MARK_ALERT_COOLDOWN=300
# MARK_LLM_BACKEND=multi_provider
# MARK_TEXT_MODEL=qwen/qwen3.8-27b
# MARK_CODE_MODEL=openai/gpt-oss-120b
# MARK_FAST_MODEL=qwen/qwen3.8-27b
# MARK_VISION_MODEL=gemini-3.1-flash-lite
# MARK_PROFILE=balanced
# MARK_BROWSER_CDP_URL=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_ROOM=mark-room
# LIVEKIT_PARTICIPANT=mark-agent
# LIVEKIT_REMOTE_IDENTITY=mark-user
# Optional low-resolution desktop preview; disabled by default.
# MARK_LIVEKIT_DESKTOP_PREVIEW=0
# Enable locally, then explicitly say start desktop preview / stop desktop preview.

# Optional gesture mouse tuning (distances are relative to palm width).
# MARK_GESTURE_SENSITIVITY=1.0
# MARK_GESTURE_SMOOTHING=0.25
# MARK_GESTURE_PINCH=0.32
# MARK_GESTURE_RELEASE=0.46
# MARK_GESTURE_DEBOUNCE=0.20
# MARK_GESTURE_DRAG_HOLD=0.8
# MARK_GESTURE_FIST_HOLD=0.8
